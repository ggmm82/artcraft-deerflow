# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim
USER root
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates python3 binutils ffmpeg fontconfig fonts-dejavu-core fonts-liberation fonts-noto-core \
    libasound2 libfontconfig1 libfreetype6 libglib2.0-0 libgtk-3-0 \
    libgl1 libegl1 libx11-6 libxcursor1 libxi6 libxrandr2 libxkbcommon0 \
    libvulkan1 mesa-vulkan-drivers libgl1-mesa-dri libdbus-1-3 git \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g @openai/codex@0.162.1 @google/gemini-cli@0.64.0 \
    && codex --version && gemini --version && npm cache clean --force
COPY versions.lock.json /opt/artcraft/versions.lock.json
COPY scripts/install_artcraft.py scripts/craft.py scripts/smoke.py /opt/artcraft/
COPY scripts/check_provider_clis.py /opt/artcraft/
RUN python3 /opt/artcraft/check_provider_clis.py
RUN python3 /opt/artcraft/install_artcraft.py --arch "$TARGETARCH" \
    && chmod 755 /opt/artcraft/craft.py \
    && ln -s /opt/artcraft/craft.py /usr/local/bin/craft \
    && fc-cache -f \
    && python3 /opt/artcraft/smoke.py --output /opt/artcraft/build-checks.json
COPY skills /mnt/skills
COPY studio/run_agent.py studio/handoff.py studio/deepseek.py /opt/studio/
ENV TZ=Europe/Rome LANG=C.UTF-8 LC_ALL=C.UTF-8 NO_BROWSER=true
WORKDIR /mnt/user-data
CMD ["python3", "/opt/artcraft/smoke.py", "--mcp", "--output", "/tmp/smoke.json"]
