# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim
USER root
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates python3 binutils xz-utils libsm6 libice6 libxfixes3 libxrender1 libxxf86vm1 libgomp1 fontconfig fonts-dejavu-core fonts-liberation fonts-noto-core \
    libasound2 libfontconfig1 libfreetype6 libglib2.0-0 libgtk-3-0 \
    libgl1 libegl1 libx11-6 libxcursor1 libxi6 libxrandr2 libxkbcommon0 \
    xvfb xauth libxcb-cursor0 libxcb-icccm4 libxcb-keysyms1 libxcb-render-util0 libxcb-xinerama0 libxkbcommon-x11-0 \
    libnss3 libopengl0 libvulkan1 mesa-vulkan-drivers libgl1-mesa-dri libdbus-1-3 git \
    libgnutls28-dev libwebp-dev libaom-dev libdav1d-dev libsoxr-dev librubberband-dev \
    pkg-config nasm libglib2.0-dev libsndfile1-dev libx264-dev libx265-dev libvpx-dev \
    libopus-dev libmp3lame-dev libvorbis-dev libfreetype6-dev libfontconfig1-dev libass-dev libharfbuzz-dev \
    zlib1g-dev libbz2-dev liblzma-dev cmake g++ make default-jre-headless libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
    libxcomposite1 libxdamage1 libgbm1 libpango-1.0-0 libcairo2 libatspi2.0-0 \
    && rm -rf /var/lib/apt/lists/*
ENV AGY_CLI_DISABLE_AUTO_UPDATE=true
COPY versions.lock.json /opt/artcraft/versions.lock.json
RUN codex_version="$(node -p 'require("/opt/artcraft/versions.lock.json").cli_runtimes.codex')" \
    && npm install -g "@openai/codex@$codex_version" \
    && codex --version && npm cache clean --force
COPY scripts/install_antigravity.py scripts/antigravity.lock.json /opt/artcraft/
RUN python3 /opt/artcraft/install_antigravity.py "$TARGETARCH" && agy --version
COPY scripts/install_artcraft.py /opt/artcraft/
COPY config/toolkit /opt/artcraft/toolkit-lock/
COPY scripts/check_provider_clis.py /opt/artcraft/
RUN python3 /opt/artcraft/check_provider_clis.py
# Install hashed native distributions before copying frequently revised adapters.
RUN python3 /opt/artcraft/install_artcraft.py --arch "$TARGETARCH" && fc-cache -f \
    && for name in ffmpeg ffprobe; do \
         if [ ! -e "/usr/bin/$name" ]; then \
           printf '#!/bin/sh\nexec /usr/local/bin/%s "$@"\n' "$name" > "/usr/bin/$name"; \
           chmod 755 "/usr/bin/$name"; \
         fi; \
       done
# Explicit Qt XCB dependencies: no longer inherited from Debian's FreeCAD package.
RUN apt-get update && apt-get install -y --no-install-recommends libxcb-shape0 libxcb-sync1 \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/runtime_policy.py /opt/artcraft/
COPY scripts/craft.py scripts/smoke.py scripts/acceptance.py scripts/acceptance_toolkit.py /opt/artcraft/
COPY scripts/blender_cli.py scripts/blender_job.py scripts/calibre_cli.py scripts/calibre_job.py /opt/artcraft/
COPY scripts/toolkit_cli.py scripts/toolkit_specs.py scripts/toolkit_job.py scripts/toolkit_browser.cjs scripts/toolkit_capture.py /opt/artcraft/
COPY studio/operations.py studio/resource_usage.py /opt/artcraft/
RUN chmod 755 /opt/artcraft/craft.py /opt/artcraft/blender_cli.py /opt/artcraft/calibre_cli.py /opt/artcraft/toolkit_cli.py \
    && ln -s /opt/artcraft/craft.py /usr/local/bin/craft \
    && ln -s /opt/artcraft/blender_cli.py /usr/local/bin/blender-cli \
    && ln -s /opt/artcraft/calibre_cli.py /usr/local/bin/calibre-cli \
    && for app in playwright aubio fluidsynth epubcheck pandoc typst freecad whisper-cpp ffmpeg; do ln -s /opt/artcraft/toolkit_cli.py "/usr/local/bin/$app-cli"; done \
    && python3 /opt/artcraft/smoke.py --output /opt/artcraft/build-checks.json
COPY skills /mnt/skills
COPY config/tool-capabilities.json /opt/artcraft/tool-capabilities.json
COPY scripts/capability_catalog.py scripts/check_tool_capabilities.py /opt/artcraft/
COPY studio/run_agent.py studio/handoff.py studio/deepseek.py studio/refresh_codex.py /opt/studio/
COPY studio/openai_compatible.py /opt/studio/
COPY studio/antigravity_cli.py studio/terminal_text.py /opt/studio/
COPY studio/progress.py studio/cli_runner.py studio/work_results.py studio/operations.py studio/resource_usage.py /opt/studio/
COPY studio/codex_native.py studio/worker_context.py studio/audit_log.py studio/command_details.py /opt/studio/
COPY studio/source_packages.py studio/deliveries.py studio/acceptance.py studio/revision.py /opt/studio/
COPY studio/component_sources.py studio/timing.py /opt/studio/
ENV TZ=Europe/Rome LANG=C.UTF-8 LC_ALL=C.UTF-8 NO_BROWSER=true
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/artcraft/playwright-browsers
WORKDIR /mnt/user-data
CMD ["python3", "/opt/artcraft/smoke.py", "--mcp", "--output", "/tmp/smoke.json"]
