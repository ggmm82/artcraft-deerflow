# Copiare in .env per l'avvio locale. In Hostinger servono STUDIO_PASSWORD e TRAEFIK_HOST.
# Solo il proxy Caddy locale usa STUDIO_USER, STUDIO_DOMAIN e STUDIO_BIND_IP.
STUDIO_USER=admin
STUDIO_PASSWORD=
# Vuoto per prove HTTP locali; dominio senza https:// per Caddy HTTPS.
STUDIO_DOMAIN=
STUDIO_PUBLIC_URL=http://localhost:2026
STUDIO_BIND_IP=0.0.0.0
# Dominio base del Traefik Hostinger, per esempio srv1757745.hstgr.cloud.
TRAEFIK_HOST=
